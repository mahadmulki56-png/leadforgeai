rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Business Leads collection
    match /leads/{leadId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }

    // CRM Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }

    // Automation Sequences collection
    match /sequences/{sequenceId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }
  }
}
