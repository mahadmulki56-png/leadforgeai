# NEXT_PUBLIC_API_URL: Public backend API URL for Vercel production frontend (e.g. https://ais-dev-y4xelwwfqopuc5dhmpzdut-777724034521.europe-west2.run.app)
NEXT_PUBLIC_API_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# BUSINESS_DATA_PROVIDER: Set to "google" or "openstreetmap". Defaults to "google" when GOOGLE_MAPS_API_KEY is present, or "openstreetmap" (free, open data provider).
BUSINESS_DATA_PROVIDER="openstreetmap"

# GOOGLE_MAPS_API_KEY / GOOGLE_PLACES_API_KEY: Secret key for Google Places TextSearch & Place Details.
GOOGLE_MAPS_API_KEY=""

# APP_ENV: Set to "production" or "development".
APP_ENV="production"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

